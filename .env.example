# Copy to .env. Local keys come from `make env` (.env.local); do not paste them here.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-4-5          # verify current model id in docs.claude.com before use
EMBEDDINGS_PROVIDER=ollama             # ollama | openai
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
TUTOR_TTS=browser                      # browser | server
TUTOR_WEB_SEARCH=off                   # off | on  (adapter in backend/tutor/web_search.py)
TUTOR_REFRESH_TOKEN=change-me          # guards POST /internal/refresh (local only)
LAB_DB_URL=                            # set by make up from DB_URL with /lab
RERANK=0
