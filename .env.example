# Copy to .env. Local keys come from `make env` (.env.local); do not paste them here.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-5-5          # current Sonnet (verified 2026-10-21)
TUTOR_EFFORT=medium                    # low | medium | high; medium suits multistep tool use
EMBEDDINGS_PROVIDER=ollama             # ollama | openai
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
TUTOR_WEB_SEARCH=off                   # off | on  (adapter in backend/tutor/web.py)
TUTOR_WEB_PROVIDER=                    # brave | tavily (empty: whichever key is set, Brave first)
BRAVE_SEARCH_API_KEY=                  # api.search.brave.com (monthly free credits)
TAVILY_API_KEY=                        # tavily.com (1,000 free credits a month)
TUTOR_REFRESH_TOKEN=change-me          # guards POST /internal/refresh (local only)
LAB_DB_URL=                            # set by make up from DB_URL with /lab
RERANK=0
# Local dev learner, written here by `make dev-user` on first run (local Supabase only):
# TUTOR_DEV_EMAIL=
# TUTOR_DEV_PASSWORD=
TUTOR_TTS=browser                     # browser | server (server: local Piper via `make tts`, browser fallback)
PIPER_URL=http://127.0.0.1:5002       # Piper HTTP server started by `make tts`
PIPER_VOICE_DE=de_DE-thorsten-high    # German server voice
PIPER_VOICE_EN=en_US-ryan-high        # English server voice (empty: English uses the browser voice)
